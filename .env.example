OLLAMA_HOST=http://127.0.0.1:11434
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Optional: only for the pyannote backend. The default diarize backend needs no token.
HF_TOKEN=
ALLOW_CLOUD_ANALYSIS=0
# Leave STT_MODEL unset for automatic hardware selection (small on CPU).
# STT_MODEL=large-v3
DEVICE=auto
OLLAMA_MODEL=auto
